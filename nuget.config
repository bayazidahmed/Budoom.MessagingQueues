<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Only nuget.org, whatever else the machine has configured. With central package management, a second
    source (a company feed in the user-level NuGet.Config, say) raises NU1507, which TreatWarningsAsErrors
    turns into a build failure, and nothing in this repo should ever come from a private feed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
